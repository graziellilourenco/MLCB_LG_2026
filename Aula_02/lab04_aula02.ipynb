import pandas as pd
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.tree import DecisionTreeClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

dados_viagens = {
    'mensagem': [
        'Quero comprar uma passagem',
        'Preciso de uma passagem para São Paulo',
        'Gostaria de reservar um voo',
        'Quero viajar para o Rio de Janeiro',
        'Preciso comprar uma passagem aérea',

        'Quero cancelar minha reserva',
        'Preciso cancelar meu voo',
        'Como faço para cancelar a passagem?',
        'Não vou mais viajar e quero cancelar',
        'Desejo cancelar minha reserva',

        'Quero falar com um atendente',
        'Preciso de ajuda de uma pessoa',
        'Posso falar com um atendente?',
        'Quero conversar com o suporte',
        'Preciso falar com alguém'
    ],
    'intencao': [
        'comprar_passagem',
        'comprar_passagem',
        'comprar_passagem',
        'comprar_passagem',
        'comprar_passagem',

        'cancelar_reserva',
        'cancelar_reserva',
        'cancelar_reserva',
        'cancelar_reserva',
        'cancelar_reserva',

        'falar_atendente',
        'falar_atendente',
        'falar_atendente',
        'falar_atendente',
        'falar_atendente'
    ]
}

df = pd.DataFrame(dados_viagens)

X = df['mensagem']
y = df['intencao']

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.3,
    random_state=42,
    stratify=y
)

vectorizer = CountVectorizer()

X_train_vec = vectorizer.fit_transform(X_train)
X_test_vec = vectorizer.transform(X_test)

modelo_arvore = DecisionTreeClassifier(random_state=42)

modelo_arvore.fit(X_train_vec, y_train)

predicoes = modelo_arvore.predict(X_test_vec)

acuracia = accuracy_score(y_test, predicoes)

print(f"Acurácia do Modelo: {acuracia * 100:.2f}%")

frases_novas = [
    'Gostaria de comprar um voo para Salvador',
    'Quero desistir da minha viagem',
    'Preciso conversar com um atendente'
]

frases_novas_vec = vectorizer.transform(frases_novas)

previsoes_novas = modelo_arvore.predict(frases_novas_vec)

for frase, intencao in zip(frases_novas, previsoes_novas):
    print(f'Mensagem: {frase}')
    print(f'Intenção prevista: {intencao}\n')
