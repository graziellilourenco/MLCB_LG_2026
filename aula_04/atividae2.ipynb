import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import confusion_matrix, classification_report, accuracy_score

print("=" * 70)
print("CLASSIFICADOR DE INTENÇÕES - SAC MÓVEIS RESIDENCIAIS")
print("=" * 70)

df_moveis = pd.read_csv(
    "dataset_moveis_100.csv",
    encoding="utf-8"
)

print("\nDataset carregado com sucesso!")
print(f"Total de registros: {len(df_moveis)}")

print("\nDistribuição das intenções:")
print(df_moveis["intencao"].value_counts())

X = df_moveis["texto"]
y = df_moveis["intencao"]

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.30,
    random_state=42,
    stratify=y
)

print("\nDivisão dos dados:")
print(f"Dados de treino: {len(X_train)}")
print(f"Dados de teste: {len(X_test)}")

pipeline = Pipeline([
    (
        "tfidf",
        TfidfVectorizer(
            lowercase=True,
            ngram_range=(1, 2)
        )
    ),
    (
        "arvore",
        DecisionTreeClassifier(random_state=42)
    )
])

print("\nTreinando o modelo...")

pipeline.fit(X_train, y_train)

print("Modelo treinado com sucesso!")

y_pred = pipeline.predict(X_test)

acuracia = accuracy_score(y_test, y_pred)

print("\n" + "=" * 70)
print("AVALIAÇÃO DO MODELO")
print("=" * 70)

print(f"\nAcurácia: {acuracia * 100:.2f}%")

classes = pipeline.named_steps["arvore"].classes_

matriz = confusion_matrix(
    y_test,
    y_pred,
    labels=classes
)

print("\nMATRIZ DE CONFUSÃO")
print("-" * 70)
print("Classes:")
print(list(classes))
print("\nMatriz:")
print(matriz)

print("\nRELATÓRIO DE CLASSIFICAÇÃO")
print("-" * 70)

print(
    classification_report(
        y_test,
        y_pred,
        labels=classes,
        zero_division=0
    )
)

print("\n" + "=" * 70)
print("ATENDIMENTO INTERATIVO")
print("=" * 70)

print("\nDigite 8 frases para testar o classificador.")
print("Digite uma frase relacionada ao SAC de móveis.\n")

LIMIAR = 0.50

for i in range(1, 9):
    print("-" * 70)

    frase_usuario = input(f"Frase {i}/8: ").strip()

    if not frase_usuario:
        print("Nenhuma frase informada.")
        continue

    probabilidades = pipeline.predict_proba([frase_usuario])[0]

    maior_probabilidade = probabilidades.max()

    indice_maior_probabilidade = probabilidades.argmax()

    intencao_prevista = classes[indice_maior_probabilidade]

    if maior_probabilidade < LIMIAR:
        print("\nResposta:")
        print(
            "Desculpe, não entendi sua solicitação. "
            "Encaminhando você para um atendente humano..."
        )

        print(
            f"Confiança do modelo: "
            f"{maior_probabilidade * 100:.2f}%"
        )

    else:
        print("\nIntenção identificada:")
        print(intencao_prevista)

        print(
            f"Confiança do modelo: "
            f"{maior_probabilidade * 100:.2f}%"
        )

print("\n" + "=" * 70)
print("ATENDIMENTO FINALIZADO!")
print("=" * 70)
