import re
import numpy as np
import pandas as pd
import spacy
import nltk
from nltk.corpus import stopwords
from gensim.models import FastText
from sklearn.linear_model import LogisticRegression
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report
)

nltk.download("stopwords", quiet=True)
stop_words_pt = set(stopwords.words("portuguese"))
nlp = spacy.load("pt_core_news_sm")

def limpar_e_lemmatizar(texto):
    texto_limpo = texto.lower()
    texto_limpo = re.sub(r'[^a-záàâãéèêíïóôõöúçñ\s]', '', texto_limpo)

    doc = nlp(texto_limpo)
    tokens_filtrados = []

    for token in doc:
        if token.is_space:
            continue
        if token.text in stop_words_pt:
            continue
        if len(token.text) <= 1:
            continue
        tokens_filtrados.append(token.lemma_)

    return " ".join(tokens_filtrados)

def analisar_preprocessamento(texto):
    texto_normalizado = limpar_e_lemmatizar(texto)
    tokens_antes = texto.split()
    tokens_depois = texto_normalizado.split()

    doc = nlp(texto.lower())
    tokens_removidos = [
        token.text for token in doc
        if token.is_space or token.text in stop_words_pt or len(token.text) <= 1 or re.match(r'[^a-záàâãéèêíïóôõöúçñ\s]', token.text)
    ]

    print("Texto original:", texto)
    print("Texto normalizado:", texto_normalizado)
    print("Quantidade de caracteres:", len(texto))
    print("Quantidade de tokens antes:", len(tokens_antes))
    print("Quantidade de tokens depois:", len(tokens_depois))
    print("Tokens removidos:", tokens_removidos)
    print("Tokens finais:", tokens_depois)

print("--- EXECUTANDO TESTE DO EXERCÍCIO 1 ---")
analisar_preprocessamento("MEU sofá!!! chegou quebrado e quero DEVOLVER!!!")
print("\n" + "="*80 + "\n")

df_treino = pd.read_csv("/content/sac_moveis_ac2_treino.csv")
df_teste = pd.read_csv("/content/sac_moveis_ac2_teste.csv")
df_ood = pd.read_csv("/content/sac_moveis_ac2_ood.csv")

df_treino['mensagem_limpa'] = df_treino['mensagem'].apply(limpar_e_lemmatizar)
df_teste['mensagem_limpa'] = df_teste['mensagem'].apply(limpar_e_lemmatizar)
df_ood['mensagem_limpa'] = df_ood['mensagem'].apply(limpar_e_lemmatizar)

corpus_tokenizado = [msg.split() for msg in df_treino['mensagem_limpa']]

modelo_fasttext = FastText(
    sentences=corpus_tokenizado,
    vector_size=50,
    window=3,
    min_count=1,
    workers=4,
    sg=1
)

def obter_vetor_frase(frase, modelo):
    palavras = frase.split()
    vetores = []

    for palavra in palavras:
        if palavra in modelo.wv:
            vetores.append(modelo.wv[palavra])

    if len(vetores) == 0:
        return np.zeros(modelo.vector_size)

    vetor_medio = np.mean(vetores, axis=0)
    return vetor_medio

X_train = np.array([obter_vetor_frase(msg, modelo_fasttext) for msg in df_treino['mensagem_limpa']])
y_train = df_treino['intencao']

X_test = np.array([obter_vetor_frase(msg, modelo_fasttext) for msg in df_teste['mensagem_limpa']])
y_test = df_teste['intencao']

print("--- EXERCÍCIO 2 CONCLUÍDO ---")
print(f"Matriz de treino (X_train): {X_train.shape}")
print(f"Matriz de teste (X_test): {X_test.shape}")
print("\n" + "="*80 + "\n")

modelo_logistico = LogisticRegression(max_iter=1000)
modelo_logistico.fit(X_train, y_train)

y_pred_log = modelo_logistico.predict(X_test)

print("--- RELATÓRIO DE CLASSIFICAÇÃO (REGRESSÃO LOGÍSTICA) ---")
print(classification_report(y_test, y_pred_log))

def classificar_mensagem(mensagem, modelo, modelo_embedding, limiar=0.50):
    mensagem_limpa = limpar_e_lemmatizar(mensagem)
    vetor = obter_vetor_frase(mensagem_limpa, modelo_embedding).reshape(1, -1)

    probabilidades = modelo.predict_proba(vetor)

    max_prob_idx = np.argmax(probabilidades[0])
    confiabilidade = probabilidades[0][max_prob_idx]
    intencao = modelo.classes_[max_prob_idx]

    if confiabilidade >= limiar:
        return intencao, confiabilidade
    else:
        return "FALLBACK_HUMANO", confiabilidade

print("--- TESTES DE MENSAGENS COM FALLBACK (EXEMPLOS MANUAIS) ---")
testes = [
    "quero devolver meu sofá",
    "como faço para realizar a devolução?",
    "cadê meu pedido?",
    "meu pedido nao chego",
    "qual é a previsão do tempo?"
]

for msg in testes:
    intencao_prevista, confianca = classificar_mensagem(msg, modelo_logistico, modelo_fasttext)
    print(f"Mensagem: '{msg}' | Intenção: {intencao_prevista} | Confiança: {confianca:.2%}")

print("\n--- TESTES DE MENSAGENS FORA DO DOMÍNIO (DATASET OOD) ---")
for msg in df_ood['mensagem'].head(5):
    intencao_prevista, confianca = classificar_mensagem(msg, modelo_logistico, modelo_fasttext)
    print(f"Mensagem OOD: '{msg}' | Intenção: {intencao_prevista} | Confiança: {confianca:.2%}")

print("\n" + "="*80 + "\n")

modelo_knn = KNeighborsClassifier(n_neighbors=3)
modelo_knn.fit(X_train, y_train)

y_pred_knn = modelo_knn.predict(X_test)

acc_log = accuracy_score(y_test, y_pred_log)
prec_log = precision_score(y_test, y_pred_log, average="weighted")
rec_log = recall_score(y_test, y_pred_log, average="weighted")
f1_log = f1_score(y_test, y_pred_log, average="weighted")

acc_knn = accuracy_score(y_test, y_pred_knn)
prec_knn = precision_score(y_test, y_pred_knn, average="weighted")
rec_knn = recall_score(y_test, y_pred_knn, average="weighted")
f1_knn = f1_score(y_test, y_pred_knn, average="weighted")

tabela_comparativa = pd.DataFrame({
    'Modelo': ['Regressão Logística', 'KNN'],
    'Accuracy': [f"{acc_log*100:.2f}%", f"{acc_knn*100:.2f}%"],
    'Precision': [f"{prec_log*100:.2f}%", f"{prec_knn*100:.2f}%"],
    'Recall': [f"{rec_log*100:.2f}%", f"{rec_knn*100:.2f}%"],
    'F1': [f"{f1_log*100:.2f}%", f"{f1_knn*100:.2f}%"]
})

print("--- TABELA COMPARATIVA DE DESEMPENHO ---")
print(tabela_comparativa.to_string(index=False))
