import re
import numpy as np
import pandas as pd
import nltk
import spacy
from nltk.corpus import stopwords
from gensim.models import FastText
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report
)

nltk.download("stopwords", quiet=True)

stop_words_pt = set(stopwords.words("portuguese"))
nlp = spacy.load("pt_core_news_sm")

print("Ambiente preparado com sucesso.")

def limpar_e_lemmatizar(texto):
    if pd.isna(texto):
        return ""

    texto_limpo = str(texto).lower()

    texto_limpo = re.sub(
        r"[^a-záàâãéèêíïóôõöúçñ\s]",
        " ",
        texto_limpo
    )

    texto_limpo = re.sub(r"\s+", " ", texto_limpo).strip()

    doc = nlp(texto_limpo)

    tokens_filtrados = []

    for token in doc:
        if token.is_space:
            continue

        if token.text in stop_words_pt:
            continue

        if len(token.text) <= 1:
            continue

        tokens_filtrados.append(token.lemma_.lower())

    return " ".join(tokens_filtrados)

def analisar_preprocessamento(texto):
    texto_original = str(texto)
    texto_minusculo = texto_original.lower()

    doc_original = nlp(texto_minusculo)

    tokens_antes = [
        token.text
        for token in doc_original
        if not token.is_space
    ]

    texto_sem_caracteres_especiais = re.sub(
        r"[^a-záàâãéèêíïóôõöúçñ\s]",
        " ",
        texto_minusculo
    )

    texto_sem_caracteres_especiais = re.sub(
        r"\s+",
        " ",
        texto_sem_caracteres_especiais
    ).strip()

    doc_limpo = nlp(texto_sem_caracteres_especiais)

    tokens_removidos = [
        token.text
        for token in doc_original
        if not token.is_space
        and (
            token.is_punct
            or token.like_num
            or not re.fullmatch(
                r"[a-záàâãéèêíïóôõöúçñ]+",
                token.text
            )
        )
    ]

    tokens_removidos.extend(
        token.text
        for token in doc_limpo
        if not token.is_space
        and (
            token.text in stop_words_pt
            or len(token.text) <= 1
        )
    )

    texto_normalizado = limpar_e_lemmatizar(texto_original)
    tokens_depois = texto_normalizado.split()

    print("Texto original:")
    print(texto_original)

    print("\nTexto normalizado:")
    print(texto_normalizado)

    print("\nQuantidade de caracteres:")
    print(len(texto_original))

    print("\nQuantidade de tokens antes:")
    print(len(tokens_antes))

    print("\nQuantidade de tokens depois:")
    print(len(tokens_depois))

    print("\nTokens removidos:")
    print(tokens_removidos)

    print("\nTokens finais:")
    print(tokens_depois)

frase_teste = (
    "Gostaria de saber se vocês estão DEVOLVENDO "
    "os valores das mesas compradas!!!"
)

resultado = limpar_e_lemmatizar(frase_teste)

print("\nFrase original:")
print(frase_teste)

print("\nFrase processada:")
print(resultado)

print("\nDiagnóstico do pré-processamento:")

analisar_preprocessamento(
    "MEU sofá!!! chegou quebrado e quero DEVOLVER!!!"
)

df = pd.read_csv("/content/sac_moveis_ac2_treino.csv")

colunas_obrigatorias = {"mensagem", "intencao"}

if not colunas_obrigatorias.issubset(df.columns):
    raise ValueError(
        "O arquivo deve possuir as colunas 'mensagem' e 'intencao'."
    )

df = df.dropna(
    subset=["mensagem", "intencao"]
).copy()

df["mensagem_limpa"] = df["mensagem"].apply(
    limpar_e_lemmatizar
)

df = df[
    df["mensagem_limpa"].str.len() > 0
].reset_index(drop=True)

corpus_tokenizado = [
    mensagem.split()
    for mensagem in df["mensagem_limpa"]
]

modelo_fasttext = FastText(
    sentences=corpus_tokenizado,
    vector_size=50,
    window=3,
    min_count=1,
    workers=4,
    sg=1,
    seed=42
)

def obter_vetor_frase(frase, modelo):
    palavras = str(frase).split()
    vetores = []

    for palavra in palavras:
        vetor = modelo.wv[palavra]
        vetores.append(vetor)

    if len(vetores) == 0:
        return np.zeros(
            modelo.vector_size,
            dtype=np.float32
        )

    vetor_medio = np.mean(
        vetores,
        axis=0
    )

    return vetor_medio

X_vetores = np.vstack([
    obter_vetor_frase(
        mensagem,
        modelo_fasttext
    )
    for mensagem in df["mensagem_limpa"]
])

y = df["intencao"].to_numpy()

X_train_vec, X_test_vec, y_train, y_test = train_test_split(
    X_vetores,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nDimensões dos dados:")

print(
    "Matriz de treinamento:",
    X_train_vec.shape
)

print(
    "Matriz de teste:",
    X_test_vec.shape
)

modelo_logistico = LogisticRegression(
    max_iter=1000,
    random_state=42
)

modelo_logistico.fit(
    X_train_vec,
    y_train
)

y_pred_logistico = modelo_logistico.predict(
    X_test_vec
)

print(
    "\nRelatório de classificação da Regressão Logística:"
)

print(
    classification_report(
        y_test,
        y_pred_logistico,
        zero_division=0
    )
)

def classificar_mensagem(
    mensagem,
    modelo,
    modelo_embedding,
    limiar=0.50
):
    mensagem_limpa = limpar_e_lemmatizar(
        mensagem
    )

    vetor = obter_vetor_frase(
        mensagem_limpa,
        modelo_embedding
    ).reshape(1, -1)

    probabilidades = modelo.predict_proba(
        vetor
    )[0]

    indice_maior_probabilidade = int(
        np.argmax(probabilidades)
    )

    confianca = float(
        probabilidades[indice_maior_probabilidade]
    )

    intencao = modelo.classes_[
        indice_maior_probabilidade
    ]

    if confianca >= limiar:
        return intencao, confianca

    return "FALLBACK_HUMANO", confianca

testes = [
    "quero devolver meu sofá",
    "como faço para realizar a devolução?",
    "cadê meu pedido?",
    "meu pedido nao chego",
    "qual é a previsão do tempo?"
]

print("\nTestes do classificador com fallback:")

for mensagem in testes:
    intencao_prevista, confianca = classificar_mensagem(
        mensagem,
        modelo_logistico,
        modelo_fasttext,
        limiar=0.50
    )

    print(
        f"Mensagem: {mensagem!r} | "
        f"Intenção: {intencao_prevista} | "
        f"Confiança: {confianca:.2%}"
    )

modelo_knn = KNeighborsClassifier(
    n_neighbors=3
)

modelo_knn.fit(
    X_train_vec,
    y_train
)

y_pred_knn = modelo_knn.predict(
    X_test_vec
)

metricas_logistico = {
    "Modelo": "Regressão Logística",
    "Accuracy": accuracy_score(
        y_test,
        y_pred_logistico
    ),
    "Precision": precision_score(
        y_test,
        y_pred_logistico,
        average="weighted",
        zero_division=0
    ),
    "Recall": recall_score(
        y_test,
        y_pred_logistico,
        average="weighted",
        zero_division=0
    ),
    "F1": f1_score(
        y_test,
        y_pred_logistico,
        average="weighted",
        zero_division=0
    )
}

metricas_knn = {
    "Modelo": "KNN",
    "Accuracy": accuracy_score(
        y_test,
        y_pred_knn
    ),
    "Precision": precision_score(
        y_test,
        y_pred_knn,
        average="weighted",
        zero_division=0
    ),
    "Recall": recall_score(
        y_test,
        y_pred_knn,
        average="weighted",
        zero_division=0
    ),
    "F1": f1_score(
        y_test,
        y_pred_knn,
        average="weighted",
        zero_division=0
    )
}

tabela_comparativa = pd.DataFrame([
    metricas_logistico,
    metricas_knn
])

tabela_exibicao = tabela_comparativa.copy()

for coluna in [
    "Accuracy",
    "Precision",
    "Recall",
    "F1"
]:
    tabela_exibicao[coluna] = tabela_exibicao[
        coluna
    ].map(
        lambda valor: f"{valor:.2%}"
    )

print("\nTabela comparativa de desempenho:")

print(
    tabela_exibicao.to_string(
        index=False
    )
)
